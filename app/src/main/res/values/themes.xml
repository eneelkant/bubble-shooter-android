<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BubbleShooter" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_glow</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ad_strip</item>
        <item name="android:windowBackground">@color/game_bg</item>
    </style>

    <style name="Widget.BubbleShooter.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_bg</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Widget.BubbleShooter.IconButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">#332A5A7A</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
